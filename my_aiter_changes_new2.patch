+    bf16_4_t tmp1 = scaled_vec_conversion<bf16_4_t, uint16_t>((uint16_t)packed, scale);
+    bf16_4_t tmp2 = scaled_vec_conversion<bf16_4_t, uint16_t>((uint16_t)(packed >> 16U), scale);
+    bf16_8_t res;
+    res.x = tmp1.x;
+    res.y = tmp1.y;
+    res.z = tmp2.x;
+    res.w = tmp2.y;
+    return res;
